<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default entry-row template (GTK Builder XML).

  Widget ids the row renderer binds to:
    row           GtkBox  – the row container (gets css classes `row` /
                            `row-selected` plus `provider-<id>`)
    clickable     GtkBox  – click target; receives the pointer cursor and a
                            click controller which selects / double-click submits
    icon          GtkImage – entry icon (pixel size is set from [ui].icon_size)
    title-area    GtkBox  – holds the title (and optional subtitle)
    title         GtkLabel – primary label
    subtitle      GtkLabel – secondary label; shown only when the entry has one
    scores        GtkBox  – holds the score labels
    score-base    GtkLabel – base (fuzzy) score label
    score-history GtkLabel – history score label; shown only when present
    boost         GtkButton – "+" history button; shown only for entries with
                              a history key
    delete        GtkButton – "−" history button; shown only for entries with
                              a history key

  A provider may override this with `providers/<id>/entry.ui` inside a theme.
  Non-standard widgets (e.g. GtkImage decorations) are fine — anything with a
  known id is bound, the rest is left alone.
-->
<interface>
  <object class="GtkBox" id="row">
    <property name="orientation">horizontal</property>
    <property name="spacing">8</property>
    <property name="valign">center</property>
    <child>
      <object class="GtkBox" id="clickable">
        <property name="orientation">horizontal</property>
        <property name="spacing">12</property>
        <property name="hexpand">true</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkImage" id="icon">
            <property name="pixel-size">24</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="title-area">
            <property name="orientation">horizontal</property>
            <property name="spacing">12</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkLabel" id="title">
                <property name="ellipsize">end</property>
                <property name="halign">start</property>
                <property name="xalign">0</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="subtitle">
                <property name="halign">start</property>
                <property name="visible">false</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="scores">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLabel" id="score-base">
                <property name="label">0.00</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="score-history">
                <property name="label">0.00</property>
                <property name="visible">false</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="boost">
        <property name="label">+</property>
        <property name="focusable">false</property>
        <property name="valign">center</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="delete">
        <property name="label">−</property>
        <property name="focusable">false</property>
        <property name="valign">center</property>
      </object>
    </child>
  </object>
</interface>