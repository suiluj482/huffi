<?xml version="1.0" encoding="UTF-8"?>
<!--
  Date layout variant for the calculator.

  Selected automatically for rink date results (`now`, `today`,
  `now + 3 days`, ...) via the `date` variant name. Dates are the one result
  kind where the relative and absolute forms are both worth showing, so rather
  than stacking them below the title like the provider template does, the
  relative form moves up next to it and the absolute one trails to the right as
  de-emphasised context.

  Declared detail keys: human, absolute.

  Resolved from providers/calculator/date/entry.ui, ahead of
  providers/calculator/entry.ui.
-->
<interface>
  <object class="GtkBox" id="row">
    <property name="orientation">horizontal</property>
    <property name="spacing">8</property>
    <property name="valign">center</property>
    <child>
      <object class="GtkBox" id="clickable">
        <property name="orientation">horizontal</property>
        <property name="spacing">12</property>
        <property name="hexpand">true</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkImage" id="icon">
            <property name="pixel-size">24</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="title-area">
            <property name="orientation">horizontal</property>
            <property name="spacing">12</property>
            <property name="hexpand">true</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLabel" id="title">
                <property name="ellipsize">end</property>
                <property name="halign">start</property>
                <property name="xalign">0</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="detail-human">
                <property name="visible">false</property>
                <property name="halign">start</property>
                <property name="xalign">0</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="detail-absolute">
            <property name="visible">false</property>
            <property name="halign">end</property>
            <property name="xalign">1</property>
            <property name="ellipsize">end</property>
            <property name="max-width-chars">26</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="scores">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLabel" id="score-base">
                <property name="label">0.00</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="boost">
        <property name="label">+</property>
        <property name="focusable">false</property>
        <property name="valign">center</property>
        <property name="visible">false</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="delete">
        <property name="label">−</property>
        <property name="focusable">false</property>
        <property name="valign">center</property>
        <property name="visible">false</property>
      </object>
    </child>
  </object>
</interface>